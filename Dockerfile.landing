# Dockerfile.landing
# builder stage
FROM node:20-alpine AS builder
# set a fixed working directory
WORKDIR /app

# copy package definitions and install dependencies
COPY package.json package-lock.json* yarn.lock* ./
# install with npm (avoids lockfile mismatches in CI)
RUN npm install

# copy the rest of the source tree
COPY . .

# install widget-bundle dependencies (has its own package.json with vite)
RUN cd widget-bundle && npm install

# build the Next.js application
RUN npm run build

# runtime stage
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
# only keep the artifacts needed at runtime
# Next.js build output and public assets are enough; the config is bundled inside .next
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

EXPOSE 3000

# start the production server
CMD ["npm", "start"]