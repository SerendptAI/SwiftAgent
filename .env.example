# Duplicate this to .env
APP_URL='http://localhost:3000'
NEXT_PUBLIC_API_URL='https://api.swiftagents.org/'
NEXT_PUBLIC_GOOGLE_CLIENT_ID=''
ELEVENLABS_API_KEY=''
ELEVENLABS_VOICE_ID=''
GOOGLE_SITE_VERIFICATION_ID=''

# Server-to-server auth for /admin/analytics. Never prefix these with
# NEXT_PUBLIC_ — the proxy in src/app/api/admin/analytics keeps them off the
# client. ANALYTICS_SECRET_KEY reports across every company and is preferred;
# X_API_KEY is used as a fallback but scopes results to its own company.
ANALYTICS_SECRET_KEY=''
X_API_KEY=''

# Optional. Point only the analytics endpoints at a different backend, for when
# the environment in NEXT_PUBLIC_API_URL has not deployed them yet. Defaults to
# NEXT_PUBLIC_API_URL when unset.
ANALYTICS_API_URL=''