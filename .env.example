# Duplicate this to .env
APP_URL='http://localhost:3000'
NEXT_PUBLIC_API_URL='https://api.swiftagents.org/'
NEXT_PUBLIC_GOOGLE_CLIENT_ID=''
ELEVENLABS_API_KEY=''
ELEVENLABS_VOICE_ID=''
GOOGLE_SITE_VERIFICATION_ID=''

# Server-to-server auth for /admin/analytics. Never prefix these with
# NEXT_PUBLIC_ — the proxy in src/app/api/admin/analytics keeps them off the
# client. ANALYTICS_SECRET_KEY reports across every company and is preferred;
# X_API_KEY is used as a fallback but scopes results to its own company.
ANALYTICS_SECRET_KEY=''
X_API_KEY=''

# Optional. Point only the analytics endpoints at a different backend, for when
# the environment in NEXT_PUBLIC_API_URL has not deployed them yet. Defaults to
# NEXT_PUBLIC_API_URL when unset.
ANALYTICS_API_URL=''

# PostHog product analytics. The key (phc_...) is public by design — it can
# only write events. Empty disables PostHog entirely; localhost is never
# tracked regardless (src/lib/analytics.ts). Inlined at build time, so rebuild
# the Docker image after changing it.
NEXT_PUBLIC_POSTHOG_KEY=''

# Cloudinary, which hosts the partner case-study clips. Only
# scripts/upload-partner-videos.mjs reads these — the site itself builds
# delivery URLs from the cloud name baked into src/lib/cloudinary.ts, so the
# app runs and builds without them. Find them at cloudinary.com/console.
CLOUD_NAME=''
API_KEY=''
API_SECRET=''

# Sanity CMS, which backs /blog and the embedded editor at /studio. Both values
# are public by design — read access to a published dataset. Leave the project
# id empty and the blog serves its empty state and /studio 404s, so the site
# still builds and runs without a CMS. Find them at sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=''
NEXT_PUBLIC_SANITY_DATASET='production'